BHARAT_BOOTSTRAP_PASSWORD=change-this-local-password
# Optional; defaults to backend/tools/tesseract/tesseract.exe on Windows
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
OCR_CONFIDENCE_THRESHOLD=85
AREA_TOLERANCE_HA=0.02
BHARAT_ALLOWED_ORIGINS=http://localhost:3003,http://127.0.0.1:3003
# PostgreSQL is the deployment database. setup_postgres writes a private local URL.
# BHARAT_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5433/bharatvault
# Without a database URL, SQLite remains available for tests and pre-migration rollback.
BHARAT_SOURCE_MODE=disabled
BHARAT_MOCK_SCENARIO=consistent
BHARAT_SOURCE_TIMEOUT_SECONDS=2
